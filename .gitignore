# Terraform
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
crash.*.log

# Python
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
env/
*.egg-info/
.pytest_cache/

# Credentials (CRITICAL - never commit these)
# Block known credential filename patterns rather than all JSON
service-account-*.json
gcp-key*.json
*-credentials.json
*-credentials*.json
google-credentials*.json
.env
.env.*
credentials/

# Application config that may contain real business data
app/config/vendor_lookup.json
app/.env

# Sample / real test data - never commit
app/test_invoices/
test_invoices/
*.pdf
*.jpg
*.jpeg
*.png
!docs/**/*.png
!docs/**/*.jpg

# Extracted invoice data - contains real GSTINs and business info
app/extraction_samples/
extraction_samples/

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Logs
*.log